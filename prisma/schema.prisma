generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  address     String
  city        String
  state       String
  zip         String?
  phone       String?
  website     String?
  hours       Json?
  lat         Float?
  lng         Float?
  description String?
  categories  String[]
  yelpId      String?  @unique
  googleId    String?  @unique
  rating      Float?
  reviewCount Int?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state])
  @@index([city])
  @@index([state, city])
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  price       String?
  affiliate   String   // "ebay" or "amazon"
  affiliateUrl String
  source      String?  // e.g. "eBay", "Amazon"
  category    String?  // e.g. "vintage-clothing", "furniture"
  position    Int      @default(0) // order in carousel
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([affiliate])
  @@index([active])
}
